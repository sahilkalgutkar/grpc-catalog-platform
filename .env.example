# Host ports catalog-service publishes. Both are overridable: 9090 is
# Prometheus' default and 8080 is the default for most things, so either can
# already be taken. Only the host side moves -- catalog-service still reaches
# pricing-service over the compose network on pricing-service:9091 either way,
# and pricing-service is deliberately not published at all.
#
# Copy this to .env, or set them inline:
#   GATEWAY_HOST_PORT=8090 docker compose up --build

GRPC_HOST_PORT=9090
GATEWAY_HOST_PORT=8080
